<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>RimMT</AssemblyName>
    <RootNamespace>RimMT</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>..\..\1.5\Assemblies\</OutputPath>
    <Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>
  </PropertyGroup>

  <!--
    V0.10.0 Lean MT Rebase keeps only production code with demonstrated useful work or core
    infrastructure. Superseded experiments, deep profilers, zero-yield consumers and the
    V0.9.5-V0.9.12 continuation/predictive path stay in repository history but are not emitted
    into RimMT.dll.
  -->
  <ItemGroup>
    <Compile Remove="AI\AdaptiveGenClosestAssist.cs" />
    <Compile Remove="AI\AsyncJobCandidatePlan04182.cs" />
    <Compile Remove="AI\DoBillTailFabric092.cs" />
    <Compile Remove="AI\JobPackageLocalSearch0419.cs" />
    <Compile Remove="AI\ParallelRegionConnectivity.cs" />
    <Compile Remove="AI\ParallelWorkPrefilter.cs" />
    <Compile Remove="AI\PathSnapshotWorker.cs" />
    <Compile Remove="AI\ResumableJobGiver095.cs" />
    <Compile Remove="AI\SafePathClassTelemetry0418.cs" />
    <Compile Remove="AI\SingleCallCandidatePartition.cs" />
    <Compile Remove="Compatibility\WorkPrefilterCompatibility04171.cs" />
    <Compile Remove="Compatibility\WorkPrefilterCompatibility04172.cs" />
    <Compile Remove="Diagnostics\HotPathProfiler.cs" />
    <Compile Remove="Diagnostics\JobGiverInfrastructureProfiler.cs" />
    <Compile Remove="Diagnostics\JobGiverTailTelemetry094.cs" />
    <Compile Remove="Diagnostics\ReachabilityPatchCensus.cs" />
    <Compile Remove="Diagnostics\WorkGiverProfiler.cs" />
    <Compile Remove="Patches\HotPathPatches.cs" />
    <Compile Remove="Patches\PathSnapshotSafetyPatches.cs" />
    <Compile Remove="Patches\ThingOverlayCache.cs" />
    <Compile Remove="Patches\WorkGiverDetailPatches.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.5.4063" />
    <PackageReference Include="Lib.Harmony" Version="2.3.3" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
