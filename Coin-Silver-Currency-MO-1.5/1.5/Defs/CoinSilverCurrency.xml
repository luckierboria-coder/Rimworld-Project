<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    V3.1 intentionally does NOT define a SpecialThingFilterDef.
    RimWorld 1.5 ThingCategoryNodeDatabase.FinalizeInit dereferences
    SpecialThingFilterDef.parentCategory without a null guard. V3.0 omitted
    parentCategory and could therefore abort play-data loading.
    Actual Coinage metallic defs are injected directly into these filters
    after all runtime-generated Coin_* defs exist.
  -->
  <RecipeDef Name="Allen_SmeltPureMetalCoinBase" Abstract="True" ParentName="DankPyon_SmelterBase">
    <description>Remelt pure metal Coinage coins back into the metal they were minted from.</description>
    <jobString>Smelting pure metal coins back into metal.</jobString>
    <targetCountAdjustment>1</targetCountAdjustment>
    <allowMixingIngredients>false</allowMixingIngredients>
    <fixedIngredientFilter />
    <products><Silver>1</Silver></products>
    <recipeUsers Inherit="False"><li>DankPyon_Furnace</li></recipeUsers>
  </RecipeDef>

  <RecipeDef ParentName="Allen_SmeltPureMetalCoinBase">
    <defName>Allen_SmeltPureMetalCoin10</defName>
    <label>Smelt 10 pure metal coins</label>
    <workAmount>600</workAmount>
    <ingredients><li><filter /><count>10</count></li></ingredients>
  </RecipeDef>

  <RecipeDef ParentName="Allen_SmeltPureMetalCoinBase">
    <defName>Allen_SmeltPureMetalCoin100</defName>
    <label>Smelt 100 pure metal coins</label>
    <workAmount>6000</workAmount>
    <ingredients><li><filter /><count>100</count></li></ingredients>
  </RecipeDef>

  <RecipeDef ParentName="Allen_SmeltPureMetalCoinBase">
    <defName>Allen_SmeltPureMetalCoin1000</defName>
    <label>Smelt 1000 pure metal coins</label>
    <workAmount>60000</workAmount>
    <ingredients><li><filter /><count>1000</count></li></ingredients>
  </RecipeDef>

  <RecipeDef ParentName="Allen_SmeltPureMetalCoinBase">
    <defName>Allen_SmeltPureMetalCoin2000</defName>
    <label>Smelt 2000 pure metal coins</label>
    <workAmount>120000</workAmount>
    <ingredients><li><filter /><count>2000</count></li></ingredients>
  </RecipeDef>
</Defs>