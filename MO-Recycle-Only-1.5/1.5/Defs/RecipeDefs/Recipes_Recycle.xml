<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <RecipeDef>
    <defName>Allen_MO_RecycleApparel</defName>
    <label>recycle apparel</label>
    <description>Carefully dismantle unwanted clothing and recover part of its original materials.</description>
    <jobString>Recycling apparel.</jobString>
    <workAmount>600</workAmount><!-- Runtime scales this by current durability fraction; 100%=600, 50%=300, 10%=60 -->
    <workSkill>Crafting</workSkill>
    <workSkillLearnFactor>1</workSkillLearnFactor>
    <effectWorking>Tailor</effectWorking>
    <soundWorking>Recipe_Tailor</soundWorking>
    <ingredients>
      <li>
        <filter>
          <categories>
            <li>Apparel</li>
          </categories>
          <disallowedCategories>
            <li>ApparelArmor</li>
          </disallowedCategories>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <categories>
        <li>Apparel</li>
      </categories>
      <disallowedCategories>
        <li>ApparelArmor</li>
      </disallowedCategories>
    </fixedIngredientFilter>
    <defaultIngredientFilter>
      <categories>
        <li>Apparel</li>
      </categories>
      <disallowedCategories>
        <li>ApparelArmor</li>
      </disallowedCategories>
    </defaultIngredientFilter>
    <requiredGiverWorkType>Smithing</requiredGiverWorkType>
    <recipeUsers>
      <li>DankPyon_MendingBench</li>
    </recipeUsers>
    <researchPrerequisites>
      <li>DankPyon_Tailoring</li>
    </researchPrerequisites>
  </RecipeDef>

